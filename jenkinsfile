pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "misbah2/compare-appt2025:latest"
        BUILD_PLAYBOOK = "build-push-docker.yml"
        DEPLOY_PLAYBOOK = "deploy_compare_app.yml"
    }

    stages {
        stage('Build') {
            steps { sh 'mvn clean package -DskipTests=true' }
            post {
                success { emailext subject: "Build SUCCESS - #${BUILD_NUMBER}", body: "Build stage completed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Build FAILED - #${BUILD_NUMBER}", body: "Build stage failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Test') {
            steps { sh 'mvn test' }
            post {
                success { emailext subject: "Test SUCCESS - #${BUILD_NUMBER}", body: "Test stage completed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Test FAILED - #${BUILD_NUMBER}", body: "Test stage failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Sonar_Scan_Backend') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn clean verify sonar:sonar -Dsonar.projectKey=my-app3'
                }
            }
            post {
                success { emailext subject: "Backend Sonar Scan SUCCESS - #${BUILD_NUMBER}", body: "Sonar scan completed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Backend Sonar Scan FAILED - #${BUILD_NUMBER}", body: "Sonar scan failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Build_Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        docker run --rm -v $PWD:/app -w /app node:20 bash -c "npm install && npm run build"
                    '''
                }
            }
            post {
                success { emailext subject: "Frontend Build SUCCESS - #${BUILD_NUMBER}", body: "Frontend build completed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Frontend Build FAILED - #${BUILD_NUMBER}", body: "Frontend build failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Sonar_Scan_Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        docker run --rm -v $PWD:/app -w /app sonarsource/sonar-scanner-cli \
                        -Dsonar.projectKey=frontend \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=http://3.65.226.16:9000 \
                        -Dsonar.login=sqp_8990494f829567460b3cac2d1d9d086ebbce146a
                    '''
                }
            }
            post {
                success { emailext subject: "Frontend Sonar Scan SUCCESS - #${BUILD_NUMBER}", body: "Frontend Sonar scan completed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Frontend Sonar Scan FAILED - #${BUILD_NUMBER}", body: "Frontend Sonar scan failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Quality_Gate') {
            steps { waitForQualityGate abortPipeline: true }
            post {
                success { emailext subject: "Quality Gate SUCCESS - #${BUILD_NUMBER}", body: "Quality gate passed.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Quality Gate FAILED - #${BUILD_NUMBER}", body: "Quality gate failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Nexus_Publish') {
            steps {
                nexusArtifactUploader(
                    artifacts: [[
                        artifactId: 'numeric',
                        classifier: '',
                        file: "target/numeric-0.0.1.jar",
                        type: 'jar'
                    ]],
                    credentialsId: 'Nexus',
                    groupId: 'com.devops',
                    nexusUrl: '63.177.235.135:8081',
                    nexusVersion: 'nexus3',
                    protocol: 'http',
                    repository: 'compare-service',
                    version: "0.0.1-${BUILD_NUMBER}"
                )
            }
            post {
                success { emailext subject: "Nexus Publish SUCCESS - #${BUILD_NUMBER}", body: "Artifact uploaded successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Nexus Publish FAILED - #${BUILD_NUMBER}", body: "Artifact upload failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Build_And_Push_Docker') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh "ansible-playbook ${BUILD_PLAYBOOK}"
                }
            }
            post {
                success { emailext subject: "Docker Build & Push SUCCESS - #${BUILD_NUMBER}", body: "Docker image built & pushed successfully.\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
                failure { emailext subject: "Docker Build & Push FAILED - #${BUILD_NUMBER}", body: "Docker build/push failed!\n${env.BUILD_URL}", to: "m90714516@gmail.com" }
            }
        }

        stage('Deploy_Compare_App') {
            steps {
                sh "ansible-playbook -i hosts.ini ${DEPLOY_PLAYBOOK} --extra-vars \"docker_image=${DOCKER_IMAGE} source_file=compare-app.yaml\""
            }
            post {
                success { 
                    emailext subject: "Deploy SUCCESS - #${BUILD_NUMBER}", 
                             body: "Deployment completed successfully.\n${env.BUILD_URL}", 
                             to: "m90714516@gmail.com" 
                }
                failure { 
                    emailext subject: "Deploy FAILED - #${BUILD_NUMBER}", 
                             body: "Deployment failed!\n${env.BUILD_URL}", 
                             to: "m90714516@gmail.com" 
                }
            }
        }
    }
}
