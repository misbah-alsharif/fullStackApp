pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'misbah2'  // اسم المستخدم الخاص بـ Docker Hub
        BACKEND_IMAGE = "${DOCKERHUB_USER}/backend-demo"
        FRONTEND_IMAGE = "${DOCKERHUB_USER}/frontend-app"
        BUILD_PLAYBOOK = 'ansible/build.yml'  // ملف Playbook لبناء Docker
        DEPLOY_PLAYBOOK = 'ansible/deploy.yml'  // ملف Playbook لنشر التطبيق
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'jinkensGithub',  // أدخل credentialsId الخاص بك لـ GitHub
                    url: 'https://github.com/misbah-alsharif/fullStackApp.git'
            }
        }

        stage('Build_Backend_JAR') {
            steps {
                sh '''
                    cd demo
                    mvn clean package -DskipTests
                '''
            }
            post {
                success {
                    echo "Backend JAR Build SUCCESS ✅"
                }
                failure {
                    echo "Backend JAR Build FAILED ❌"
                }
            }
        }

        stage('Build_And_Push_Docker') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    script {
                        // بناء صورة الـ Backend
                        sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                        sh "docker build -t ${BACKEND_IMAGE} -f demo/demo/Dockerfile demo"
                        sh "docker push ${BACKEND_IMAGE}"

                        // بناء صورة الـ Frontend
                        sh "docker build -t ${FRONTEND_IMAGE} ./frontend"
                        sh "docker push ${FRONTEND_IMAGE}"  // دفع صورة الـ frontend إلى Docker Hub
                    }
                }
            }
            post {
                success {
                    echo "Docker Build & Push SUCCESS - #${BUILD_NUMBER}"
                }
                failure {
                    echo "Docker Build & Push FAILED - #${BUILD_NUMBER}"
                }
            }
        }

        stage('Upload_To_Nexus') {
            steps {
                nexusArtifactUploader artifacts: [[
                    artifactId: 'demo',
                    classifier: '',
                    file: 'demo/target/demo-0.0.1-SNAPSHOT.jar',
                    type: 'jar'
                ]],
                credentialsId: 'Nexus',
                groupId: 'com.example',
                nexusUrl: '3.65.226.16:8081',
                nexusVersion: 'nexus3',
                protocol: 'http',
                repository: 'backend',
                version: '0.0.1-SNAPSHOT'
            }
            post {
                success {
                    echo "Upload to Nexus SUCCESS ✅"
                }
                failure {
                    echo "Upload to Nexus FAILED ❌"
                }
            }
        }

        stage('Deploy_Compare_App') {
            steps {
                sh 'ansible-playbook -i ansibale/inventory.ini ansibale/deploy.yml'
            }
            post {
                success {
                    echo "Deploy SUCCESS - #${BUILD_NUMBER}"
                }
                failure {
                    echo "Deploy FAILED - #${BUILD_NUMBER}"
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline finished SUCCESSFULLY ✅'
        }
        failure {
            echo 'Pipeline failed ❌ - check logs'
        }
    }
}
