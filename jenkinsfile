pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // استنساخ الكود من GitHub
                git 'https://github.com/misbah-alsharif/fullStackApp.git'
            }
        }

        stage('Build') {
            steps {
                // مثال لأمر بناء (هنا تستخدم npm بناءً على مشروع Node.js)
                echo 'Building project...'
                sh 'npm install'
            }
        }

        stage('Test') {
            steps {
                // مثال لاختبار الوحدة أو اختبار بسيط
                echo 'Running tests...'
                sh 'npm test'
            }
        }

        stage('Deploy') {
            steps {
                // مثال للنشر (هنا يمكن إضافة أمر نشر إذا كنت تستخدم بيئة معينة)
                echo 'Deploying the application...'
                // يمكنك إضافة أوامر نشر هنا
            }
        }
    }
}
